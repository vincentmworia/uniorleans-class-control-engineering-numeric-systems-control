clear;
clc;
close all;

k = 5;
tau = 10;
Te = 5;

% Method 1 - Laplace Transform Definition
%num = [k];
%den = [tau 1];
%Gc = tf(num, den)

% Method 2 - Laplace Transform Definition
p=tf('p');
Gc = k/(1+tau*p)
Gz = c2d(Gc, Te, 'zoh')

% ZOH discretization
Gz = c2d(Gc, Te, 'zoh');

% STEP RESPONSE
figure;
step(Gc,'b', Gz,'r--');
legend('Continuous','Discrete');
title('Step Response');
grid on;

% IMPULSE RESPONSE
figure;
impulse(Gc,'b', Gz,'r--');
legend('Continuous','Discrete');
title('Impulse Response');
grid on;

% BODE PLOT
figure;
bode(Gc,'b', Gz,'r--');
legend('Continuous','Discrete');
title('Bode Plot');
grid on;

% POLE-ZERO MAP
figure;
pzmap(Gc,'b', Gz,'r--');
legend('Continuous','Discrete');
title('Continuous & Discrete Poles and Zeros');
grid on;

figure;
pzmap(Gc); title('Continuous Poles and Zeros'); grid on;

figure;
pzmap(Gz); title('Discrete Poles and Zeros'); grid on;


% POLE-ZERO MAP together
figure;
subplot(1,2,1);
pzmap(Gc);
title('Continuous Poles Zeros');

subplot(1,2,2);
pzmap(Gz);
title('Discrete Poles Zeros');
grid on;